#!/usr/bin/env python3
"""Run the reviewed checkout's locked package; no ambient Python dependencies."""
import os
from pathlib import Path
import shutil
import subprocess
import sys

root = Path(__file__).resolve().parents[1]
uv = shutil.which("uv")
if not uv:
    sys.exit("Install uv (on macOS: brew install uv), then run ios-release setup.")
app = Path(os.environ.get("IOS_APP_ROOT", os.getcwd())).resolve()
environment = {**os.environ, "UV_PROJECT_ENVIRONMENT": str(Path(os.environ.get("RUNNER_TEMP", app / "build")) / "ios-release-python")}
sys.exit(subprocess.call([uv, "run", "--locked", "--no-dev", "--project", str(root), "ios-release", *sys.argv[1:]], env=environment))
