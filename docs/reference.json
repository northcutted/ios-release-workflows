  "settings": {
    "schema_version": 1,
    "mode": "platform",
    "repository": "northcutted/ios-release-workflows",
    "output_dir": "docs",
    "pages": [
      "README.md",
      "CONTRIBUTING.md",
      "CHANGELOG.md",
      "docs",
      "examples/OrbitNotes/README.md"
    ],
    "navigation": [
      {
        "label": "Documentation",
        "path": "docs/README.md"
      },
      {
        "label": "Native quickstart",
        "path": "docs/native-quickstart.md"
      },
      {
        "label": "Native commands",
        "path": "docs/native-commands.md"
      },
      {
        "label": "Compatibility setup",
        "path": "docs/setup.md"
      },
      {
        "label": "Contributing",
        "path": "CONTRIBUTING.md"
      }
    ]
  },
  "configuration": null,
  "change_examples": [],
  "commands": {
    "schema_version": 1,
    "commands": {
      "setup": {
        "description": "Prepare the task's locked tools; --apple adds Ruby, --images adds app image dependencies"
      },
      "doctor": {
        "description": "Check Python, optional Apple tools and configured Xcode without changing them"
      },
      "check": {
        "description": "Check workflow policy, documentation and regression tests; --syntax adds actionlint"
      },
      "docs": {
        "description": "Generate or check deterministic consumer documentation"
      },
      "version": {
        "description": "Calculate a read-only candidate version and release notes"
      },
      "localization-pseudo": {
        "description": "Pseudo-localize catalogs for layout smoke checks"
      },
      "screenshots-compose": {
        "description": "Run app-owned screenshot composition with its locked image tools"
      },
      "test": {
        "description": "Run the configured simulator tests and preserve QA evidence"
      },
      "qa": {
        "description": "Run lint, localization, analysis or tests; preserve QA evidence"
      },
      "archive": {
        "description": "Archive and export locally using installed signing profiles"
      },
      "screenshots": {
        "description": "Run app-owned screenshot scenarios with locked platform dependencies"
      },
      "screenshots-capture": {
        "description": "Compatibility alias for screenshots"
      },
      "gems-install": {
        "description": "Compatibility alias for setup --apple"
      },
      "toolchain": {
        "description": "Validate Xcode and resolve exact simulators"
      },
      "screenshots-verify": {
        "description": "Validate configured screenshot coverage and dimensions"
      },
      "screenshots-publish": {
        "description": "Create the screenshot update PR in its protected workflow"
      },
      "deployment-ref": {
        "description": "Verify a protected deployment or metadata operation tag"
      },
      "release-verify": {
        "description": "Authenticate downloaded release evidence"
      },
      "controls-configure": {
        "description": "Preview repository controls; --apply explicitly changes them"
      },
      "controls-capture": {
        "description": "Capture an owner-verified repository control baseline"
      },
      "benchmark": {
        "description": "Compare workflow job timings"
      },
      "install-actionlint": {
        "description": "Install the pinned workflow validator"
      }
    }
  },
