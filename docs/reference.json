          "runner": "${{ inputs.runner }}",
          "uses": null,
          "environment": null,
          "timeout_minutes": 90,
          "permissions": {
            "contents": "read"
          },
          "secret_names": []
        },
        {
          "id": "guard",
          "name": "Require protected release controls",
          "needs": [],
          "condition": "inputs.operation != 'check'",
          "runner": "ubuntu-24.04",
          "uses": null,
          "environment": null,
          "timeout_minutes": 30,
          "permissions": {
            "contents": "read",
            "actions": "read"
          },
          "secret_names": []
        },
        {
          "id": "signing",
          "name": "Reconcile owned signing assets without compiling app code",
          "needs": [
            "guard"
          ],
          "condition": "inputs.operation == 'prepare'",
          "runner": "ubuntu-24.04",
          "uses": null,
          "environment": "native-signing-admin",
          "timeout_minutes": 30,
          "permissions": null,
          "secret_names": []
        },
        {
          "id": "qa",
          "name": "Test release inputs without signing or Apple credentials",
          "needs": [
            "signing"
          ],
          "condition": null,
          "runner": "${{ inputs.runner }}",
          "uses": null,
          "environment": null,
          "timeout_minutes": 90,
          "permissions": null,
          "secret_names": []
        },
        {
          "id": "build",
          "name": "Build app with isolated signing assets",
          "needs": [
            "signing"
          ],
          "condition": null,
          "runner": "${{ inputs.runner }}",
          "uses": null,
          "environment": "native-signing",
          "timeout_minutes": 60,
          "permissions": null,
          "secret_names": []
        },
        {
          "id": "verify",
          "name": "Verify signed IPA and matching symbols without build credentials",
          "needs": [
            "build",
            "qa",
            "signing"
          ],
          "condition": null,
          "runner": "${{ inputs.runner }}",
          "uses": null,
          "environment": null,
          "timeout_minutes": 30,
          "permissions": null,
          "secret_names": []
        },
        {
          "id": "seal",
          "name": "Seal and attest the verified release without compiling app code",
          "needs": [
            "verify",
            "qa",
            "signing"
          ],
          "condition": null,
          "runner": "ubuntu-24.04",
          "uses": null,
          "environment": null,
          "timeout_minutes": 30,
          "permissions": {
            "contents": "read",
            "id-token": "write",
            "attestations": "write",
            "artifact-metadata": "write"
          },
          "secret_names": []
        },
        {
          "id": "select",
          "name": "Authenticate the exact preparation before requesting Apple credentials",
          "needs": [
            "guard"
          ],
          "condition": "contains(fromJSON('[\"testflight\",\"stage\",\"metadata\",\"submit\",\"publish\",\"phase-pause\",\"phase-resume\",\"phase-complete\"]'), inputs.operation)",
          "runner": "ubuntu-24.04",
          "uses": null,
          "environment": null,
          "timeout_minutes": 30,
          "permissions": {
            "contents": "read",
            "actions": "read"
          },
          "secret_names": []
        },
        {
          "id": "deliver",
          "name": "Deliver verified beta or update store content",
          "needs": [
            "select"
          ],
          "condition": "contains(fromJSON('[\"testflight\",\"stage\",\"metadata\"]'), inputs.operation)",
          "runner": "ubuntu-24.04",
          "uses": null,
          "environment": "native-app-store",
          "timeout_minutes": 90,
          "permissions": {
            "contents": "read",
            "actions": "read"
          },
          "secret_names": []
        },
        {
          "id": "production",
          "name": "Owner-approved App Review or public release",
          "needs": [
            "select"
          ],
          "condition": "contains(fromJSON('[\"submit\",\"publish\",\"phase-pause\",\"phase-resume\",\"phase-complete\"]'), inputs.operation)",
          "runner": "ubuntu-24.04",
          "uses": null,
          "environment": "native-production",
          "timeout_minutes": 90,
          "permissions": {
            "contents": "read",
            "actions": "read"
          },
          "secret_names": []
        },
        {
          "id": "receipt",
          "name": "Attest operation recovery state without Apple credentials",
          "needs": [
            "deliver",
            "production",
            "select"
          ],
          "condition": "always() && (needs.deliver.result != 'skipped' || needs.production.result != 'skipped') && needs.select.result == 'success'",
          "runner": "ubuntu-24.04",
          "uses": null,
          "environment": null,
          "timeout_minutes": 30,
          "permissions": {
            "contents": "read",
            "id-token": "write",
            "attestations": "write",
            "artifact-metadata": "write"
          },
          "secret_names": []
        },
        {
          "id": "status",
          "name": "Read current Apple app and build status",
          "needs": [
            "guard"
          ],
          "condition": "inputs.operation == 'status'",
          "runner": "ubuntu-24.04",
          "uses": null,
          "environment": "native-app-store",
          "timeout_minutes": 30,
          "permissions": null,
          "secret_names": []
        }
      ]
    },
